+            if (!outsideFocus.isEmpty()) return null;
+            final boolean[] blocked = {false};
+            final boolean[] foundFocus = {false};
+            mDisplayContent.forAllWindows(candidate -> {
+                if (candidate == window) {
+                    foundFocus[0] = true;
+                    return true;
+                }
+                if (candidate.isVisible()
+                        && (candidate.mAttrs.flags & LayoutParams.FLAG_NOT_TOUCHABLE) == 0) {
+                    candidate.getEffectiveTouchableRegion(touchable);
+                    if (touchable.op(safe, Region.Op.INTERSECT)) {
+                        blocked[0] = true;
+                        return true;
+                    }
+                }
+                return false;
+            }, true /* traverseTopToBottom */);
+            if (blocked[0] || !foundFocus[0]) return null;
+            return new AiFirstGestureSession.Context(window, mAiFirstFocusEpoch, 0,
+                    UserHandle.USER_SYSTEM, mDisplayContent.getDisplayId(),
+                    info.logicalWidth, info.logicalHeight, info.rotation, density,
+                    safe.left, safe.top, safe.right, safe.bottom);
+        }
