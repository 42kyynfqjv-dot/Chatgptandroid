+            // Pointer-spy event flags do not prove which underlying window received a touch.
+            // Reject another touchable window above this app anywhere in the usable gesture area.
+            final Region touchable = new Region();
+            window.getEffectiveTouchableRegion(touchable);
+            final Region outsideFocus = new Region(safe);
