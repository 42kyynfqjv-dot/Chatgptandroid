+                return null;
+            }
+            final WindowState window = mFocusedWindow;
+            if (window == null || !window.isVisible() || !window.isDisplayed()
+                    || window.isAnimatingLw() || window.mActivityRecord == null
+                    || window.mShowUserId != UserHandle.USER_SYSTEM
+                    || UserHandle.getUserId(window.getOwningUid()) != UserHandle.USER_SYSTEM
+                    || window.mActivityRecord.mUserId != UserHandle.USER_SYSTEM
+                    || window.mActivityRecord.info.applicationInfo.uid != window.getOwningUid()
+                    || !"com.openai.chatgpt".equals(window.mActivityRecord.packageName)
+                    || !"com.openai.chatgpt".equals(window.getOwningPackage())
+                    || (window.mAttrs.type != TYPE_BASE_APPLICATION
+                            && window.mAttrs.type != LayoutParams.TYPE_APPLICATION)
+                    || (window.mAttrs.flags & LayoutParams.FLAG_NOT_TOUCHABLE) != 0
+                    || window.getWindowingMode()
+                            != android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN) {
+                return null;
+            }
+            final WindowState ime = mDisplayContent.getImeWindow();
+            if ((ime != null && ime.isVisible())
+                    || (mNotificationShade != null && mNotificationShade.isVisible())) {
+                return null;
+            }
+            final DisplayInfo info = mDisplayContent.getDisplayInfo();
+            final double density = info.logicalDensityDpi / 160.0;
+            if (!Double.isFinite(density) || density <= 0) return null;
+            final Rect display = new Rect(0, 0, info.logicalWidth, info.logicalHeight);
+            final Insets insets = mDisplayContent.getInsetsStateController().getRawInsetsState()
+                    .calculateInsets(display, display, Type.systemBars() | Type.displayCutout()
+                            | Type.systemGestures() | Type.mandatorySystemGestures(),
+                            true /* ignoreVisibility */);
+            final Rect safe = new Rect(display);
+            safe.inset(insets);
+            if (!safe.intersect(window.getFrame())) return null;
+            final int edgeGuard = (int) Math.ceil(24 * density);
+            safe.inset(edgeGuard, edgeGuard);
